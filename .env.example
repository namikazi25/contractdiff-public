# OpenAI-compatible endpoint configuration.
# Copy to .env and fill in your key:  cp .env.example .env
# .env is gitignored and must never be committed or packaged.
# Any endpoint implementing the chat completions shape works; OpenRouter is
# only the reference example.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_SECONDS=60
