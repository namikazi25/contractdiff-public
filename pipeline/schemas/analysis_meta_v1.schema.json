{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractdiff.local/schemas/analysis_meta_v1.schema.json",
  "title": "ContractDiff analysis metadata v1",
  "description": "Audit metadata recorded for one AI or deterministic analysis run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "analysis_path",
    "model",
    "prompt_version",
    "schema_version",
    "playbook_version",
    "template_version",
    "generated_at",
    "wall_time_ms",
    "usage",
    "cost_usd"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_path": {
      "enum": ["ai", "baseline"]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "schema_version": {
      "const": "findings.v1"
    },
    "playbook_version": {
      "description": "Null before the policy layer applies the playbook.",
      "type": ["string", "null"],
      "minLength": 1
    },
    "template_version": {
      "description": "Null when no template matches an unsupported contract.",
      "type": ["string", "null"],
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "wall_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "usage": {
      "description": "Null when the analysis provider does not report token usage.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
          "properties": {
            "prompt_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "completion_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_usd": {
      "description": "Null when the provider does not return cost.",
      "type": ["number", "null"],
      "minimum": 0
    }
  }
}
